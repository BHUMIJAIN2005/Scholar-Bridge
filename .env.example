# ScholarBridge Environment Variables Example

# Groq API Configuration (for ML microservice professor analyzer)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Backend Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scholarbridge
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8000
